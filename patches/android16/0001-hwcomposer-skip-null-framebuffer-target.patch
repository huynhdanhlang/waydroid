+         * There is nothing to draw then. */
+        if (m_draw_framebuffer_at != UNSET_VALUE && (!m_framebuffer_target || !m_framebuffer_target->handle)) {
+            log_frame(m_framebuffer_target ? "framebuffer target has no handle"
